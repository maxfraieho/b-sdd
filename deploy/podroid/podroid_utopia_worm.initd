#!/sbin/openrc-run
# OpenRC service script for Utopia DB WORM Daemon on Alpine Linux (Podroid)

name="podroid-utopia-worm"
description="Utopia DB Bitemporal WORM Socket Daemon (:9622)"

command="/usr/bin/python3"
command_args="/opt/laya/utopia_worm_daemon.py --host 0.0.0.0 --port 9622"
command_background="yes"
command_user="root"
directory="/opt/laya"
pidfile="/run/podroid-utopia-worm.pid"
output_log="/var/log/utopia/worm.log"
error_log="/var/log/utopia/worm.err"

depend() {
    need net
    after docker
}

start_pre() {
    checkpath -d -m 0755 -o root:root /var/log/utopia /run
}
