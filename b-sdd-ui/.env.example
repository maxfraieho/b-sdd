# B-SDD Workbench — environment variables
#
# Copy this file to `.env.local` and adjust for your setup. Vite picks
# up `.env.local` automatically at dev/build time.

# Base URL for the local B-SDD workbench server (src/server/workbench_server.py).
# Defaults to http://localhost:8765 if unset. Point at a tunnel/staging
# instance if the sovereign VPC is reachable through a proxy.
VITE_API_BASE_URL=http://localhost:8765
